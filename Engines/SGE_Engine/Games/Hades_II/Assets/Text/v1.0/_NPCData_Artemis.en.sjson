    }
    {
      Id = "Artemis_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "   !    "
      Speaker = "Artemis"
      Event = "ArtemisFirstMeeting"
    }
    {
      Id = "Melinoe_1179"
      InheritFrom = "BaseNarrative"
      DisplayName = "     "
      Speaker = "Melinoe"
      Event = "ArtemisFirstMeeting"
    }
