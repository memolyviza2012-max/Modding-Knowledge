    }
    {
      Id = "Melinoe_3598"
      InheritFrom = "BaseNarrative"
      DisplayName = "   "
      Speaker = "Melinoe"
      Event = "ArtemisHubAboutChronosBoss01"
    }
    {
      Id = "Artemis_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "!   !  ...  !"
