    }
    {
      Id = "Dionysus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = " {#Emph}{#Prev}  ?    {#Emph}! {#Prev} {#Emph}! {#Prev}   {#Emph}?! {#Prev} {#Emph}! {#Prev}!"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_2386"
      InheritFrom = "BaseNarrative"
      DisplayName = " ?   !  ? ?"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "Dionysus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph} {#Prev}    {#Emph}{#Prev}   {#Emph} {#Prev}   !  {#Emph}!"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_2387"
      InheritFrom = "BaseNarrative"
      DisplayName = "  !"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "Dionysus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = " ? {#Emph} {#Prev}!  ?"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_4329"
      InheritFrom = "BaseNarrative"
      DisplayName = " ?    ? ?"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting_B"
    }
    {
      Id = "MelinoeField_4330"
      InheritFrom = "BaseNarrative"
      DisplayName = " {#Emph} {#Prev}  "
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting_B"
    }
    {
      Id = "Dionysus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}{#Prev}  !    !"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "MelinoeField_2388"
      InheritFrom = "BaseNarrative"
      DisplayName = "    "
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "Dionysus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = " !   ? !"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "Dionysus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = " ?  !   {#Emph}! {#Prev} ?"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast02"
    }
    {
      Id = "MelinoeField_2389"
      InheritFrom = "BaseNarrative"
      DisplayName = "   ... ...  ? !"
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast02"
    }
    {
