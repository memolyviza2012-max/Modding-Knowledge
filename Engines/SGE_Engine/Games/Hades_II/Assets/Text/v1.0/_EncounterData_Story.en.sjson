      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1467"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}! {#Prev}!  !   {#Emph}! {#Prev}...!"
