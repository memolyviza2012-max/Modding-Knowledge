    }
    {
      Id = "HecateField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "! ?  ! ? ...?"
      Speaker = "Hecate"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5188"
      InheritFrom = "BaseNarrative"
      DisplayName = " ... ...   ! ...?"
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1465"
      InheritFrom = "BaseNarrative"
      DisplayName = "... ... ...  ... ...  {#Emph}! {#Prev}... ... {#Emph}?"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5189"
      InheritFrom = "BaseNarrative"
      DisplayName = "! ... ?"
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1466"
      InheritFrom = "BaseNarrative"
      DisplayName = "...    !  ...  {#Emph}{#Prev}... {#Emph}{#Prev}"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "HecateField_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "...? {#Emph}! {#Prev}! {#Emph}! {#Prev}{#Emph}{#Prev} ...! !"
