    {
      Id = "Scylla_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = " {#Emph}{#Prev} ! {#Emph} {#Prev}  {#Emph}! {#Prev}  ?    ?"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Melinoe_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "...  ?"
      Speaker = "Melinoe"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "!   {#Emph} ?!"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Melinoe_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "? ?"
      Speaker = "Melinoe"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph} {#Prev} !  ...? {#Emph} ?"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = " ! : {#Emph}{#Prev} {#Emph}{#Prev}... {#Emph} {#Prev}!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight01"
    }
    {
      Id = "MelinoeField_3538"
      InheritFrom = "BaseNarrative"
      DisplayName = "...?    ... "
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight01"
    }
    {
      Id = "Scylla_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "  !  ...! "
      Speaker = "Scylla"
