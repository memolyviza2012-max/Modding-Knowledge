    {
      Id = "Icarus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "      !  ?"
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "MelinoeField_1930"
      InheritFrom = "BaseNarrative"
      DisplayName = " !   ?"
      Speaker = "Melinoe"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph} {#Prev}:   "
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "MelinoeField_1931"
      InheritFrom = "BaseNarrative"
      DisplayName = "  "
      Speaker = "Melinoe"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = " !     !"
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0025_D"
      InheritFrom = "BaseNarrative"
      DisplayName = "...! ?  "
      Speaker = "Icarus"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "MelinoeField_2010"
      InheritFrom = "BaseNarrative"
      DisplayName = " ...     "
      Speaker = "Melinoe"
