    {
      Id = "Chronos_1480"
      InheritFrom = "BaseNarrative"
      DisplayName = " ? ...   "
      Speaker = "Chronos"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "MelinoeField_4137"
      InheritFrom = "BaseNarrative"
      DisplayName = "  ?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "Chronos_1481"
      InheritFrom = "BaseNarrative"
      DisplayName = " !  !   "
      Speaker = "Chronos"
      Event = "NeoChronosAboutErebus01"
    }
    {
