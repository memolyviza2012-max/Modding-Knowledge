    /* Hades Fountain / StoryReset Screen */
    {
      Id = "StoryResetIntro"
      DisplayName = ""
      Description = """
       {#AlertHeaderFormat}Hades II{#Prev} !

        {#AlertItalicFormat}{#Prev}    {#AlertHighlightFormat}{#Prev}   {#AlertHighlightFormat}{#Prev}  {#AlertHighlightFormat}{#Prev}... !

     ·  {#AlertBoldFormat}{#Prev}  

     · {#AlertBoldFormat}{#Prev} {#AlertBoldFormat}{!Icons.MixerIBoss} Z·Sand {#Prev} {#AlertBoldFormat}{!Icons.MixerQBoss} V·Lens {#Prev} 

     ·  {#AlertBoldFormat} {#Prev}  

    {#AlertItalicFormat}: {#Prev} 
