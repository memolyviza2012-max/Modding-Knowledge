    {
      Id = "Circe_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}{#Prev}  ! {#Emph}{#Prev} ! ? {#Emph}? {#Prev}  {#Emph}ahaha {#Prev}! "
      Speaker = "Circe"
      Event = "CirceFirstMeeting"
    }
    {
      Id = "MelinoeField_1756"
      InheritFrom = "BaseNarrative"
      DisplayName = " !  !   ?"
      Speaker = "Melinoe"
      Event = "CirceFirstMeeting"
    }
    {
      Id = "Circe_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "!    {#Emph}! {#Prev} ?"
