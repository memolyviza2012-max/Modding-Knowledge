   <Row ss:AutoFitHeight="0">
    <Cell><Data ss:Type="String">loc_15373294129891630336</Data></Cell>
    <Cell><Data ss:Type="String">Scan Typhon xenomorphs to calibrate Psychoscope</Data></Cell>
    <Cell><Data ss:Type="String">สแกนสิ่งมีชีวิตต่างดาวไทฟอนเพื่อปรับเทียบไซโคสโคป</Data></Cell>
    <Cell><Data ss:Type="String">LOCKED</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
